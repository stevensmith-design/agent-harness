#!/usr/bin/env bash
# Ref-aware backstop for routine owned-work automation.
set -e
ROOT=$(git rev-parse --show-toplevel)
MAIN=$(sed -n 's/^main_branch:[[:space:]]*//p' "$ROOT/harness.yaml" | head -1 | tr -d '"' | sed 's/[[:space:]]*#.*$//')
[ -n "$MAIN" ] || MAIN=main
ZERO=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  if [ "$remote_ref" = "refs/heads/$MAIN" ]; then
    echo "pre-push: direct updates to '$MAIN' are forbidden; merge a PR" >&2; exit 1
  fi
  case "$remote_ref" in refs/heads/*) ;; *) echo "pre-push: routine automation may push branches only ($remote_ref)" >&2; exit 1 ;; esac
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: refusing a non-fast-forward update to $remote_ref" >&2; exit 1
  fi
done
