{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write",
      "Bash(bash scripts/checkpoint.sh)", "Bash(bash scripts/check.sh)", "Bash(bash scripts/harness-check.sh)",
      "Bash(git status)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git checkout -b:*)", "Bash(git switch:*)",
      "Bash(git fetch origin --prune)", "Bash(git fetch --prune origin)", "Bash(git pull --ff-only origin:*)",
      "Bash(git push -u origin:*)", "Bash(git push origin:*)", "Bash(git branch -d:*)",
      "Bash(git worktree list)", "Bash(git worktree add:*)", "Bash(git worktree remove:*)", "Bash(git worktree prune)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh pr update-branch:*)",
      "Bash(gh pr merge * --merge --delete-branch)", "Bash(gh pr merge * --squash --delete-branch)"
    ],
    "ask": [
      "Bash(npm install:*)", "Bash(npm i:*)", "Bash(npm add:*)", "Bash(npm update:*)",
      "Bash(pnpm install:*)", "Bash(pnpm add:*)", "Bash(pnpm update:*)",
      "Bash(yarn install:*)", "Bash(yarn add:*)", "Bash(yarn up:*)",
      "Bash(bun install:*)", "Bash(bun add:*)", "Bash(pip install:*)", "Bash(pip3 install:*)",
      "Bash(./scripts/declare-harness-change.sh:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.production)", "Read(./.env.development)", "Read(./.env.test)", "Read(./.env.staging)",
      "Read(./**/*credential*)", "Read(./**/*service-account*)",
      "Read(./**/*.pem)", "Read(./**/*.key)", "Read(./**/*.p12)", "Read(./**/*.pfx)",
      "Read(./.npmrc)", "Read(./.pypirc)", "Read(./.netrc)",
      "Bash(git push --force:*)", "Bash(git push --force-with-lease:*)", "Bash(git reset --hard:*)",
      "Bash(sudo:*)", "Bash(curl:* | sh)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git fetch origin --prune", "git fetch --prune origin", "git pull --ff-only origin *", "git push -u origin *", "git push origin *", "gh pr create *", "gh pr view *", "gh pr checks *", "gh pr update-branch *", "gh pr merge *"],
    "filesystem": { "allowRead": ["."], "denyRead": ["./.env", "./.env.local", "./.env.production", "./.env.development", "./.env.test", "./.env.staging", "~/.ssh", "~/.aws"], "allowWrite": ["."] },
    "network": { "allowedDomains": ["github.com", "*.github.com"] }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/session-start.sh\"",
            "timeout": 15,
            "statusMessage": "Reading harness state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/block-sensitive-runtime.sh\"",
            "timeout": 15,
            "statusMessage": "Checking the safety boundary..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/guard-git-network.sh\"",
            "timeout": 15,
            "statusMessage": "Checking repository network command..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/block-harness-write.sh\"",
            "timeout": 15,
            "statusMessage": "Checking harness write boundary..."
          }
        ]
      }
    ]
  }
}
