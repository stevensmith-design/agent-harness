# Copy to .env with `make env-init`. Never commit .env.
# Placeholders only — real values come from the operator or the secret manager.

APP_ENV=local
APP_NAME=<product>

# Backend
API_BASE_URL=https://api.example.invalid
API_TIMEOUT_MS=15000

# Stub / mock mode: run the whole app against stub data with no backend.
# `make dev-mock` sets this. Never set it in a production build pipeline.
MOCK_MODE=false

# Auth (placeholder names only — see .agents/rules/no-secrets.md)
AUTH_DOMAIN=<auth-domain>
AUTH_CLIENT_ID=<client-id>

# Analytics / crash reporting
TELEMETRY_KEY=<key>

# ---------------------------------------------------------------------------
# MCP server credentials. Only fill in the ones .mcp.json actually references.
# Names only in this file — never a real value. See .agents/rules/no-secrets.md
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=<personal-access-token>
# SENTRY_AUTH_TOKEN=<token>
# SENTRY_ORG=<org-slug>
# FIGMA_API_KEY=<figma-api-key>
