{
  "harnessTier": "release",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(make:*)",
      "Bash(./scripts/:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git worktree:*)",
      "Bash(npm run:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm exec:*)",
      "Bash(yarn run:*)",
      "Bash(npx --no-install:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(fvm:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(npm update:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm update:*)",
      "Bash(yarn install:*)",
      "Bash(yarn add:*)",
      "Bash(yarn up:*)",
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(poetry add:*)",
      "Bash(cargo add:*)",
      "Bash(go get:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter pub get:*)",
      "Bash(dart pub add:*)",
      "Bash(dart pub get:*)",
      "Bash(gh release:*)",
      "Bash(make build)",
      "Bash(eas build:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | sh)",
      "Bash(:(){:|:&};:)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./**/*credential*)",
      "Read(./**/*service-account*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./.npmrc)",
      "Read(./.pypirc)",
      "Read(./.netrc)",
      "Edit(./AGENTS.md)",
      "Edit(./harness.config.yaml)",
      "Edit(./.agents/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./docs/decisions/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowRead": [
        "."
      ],
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.production",
        "./.env.development",
        "./.env.test",
        "./.env.staging",
        "~/.ssh",
        "~/.aws"
      ],
      "allowWrite": [
        "."
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.github.com",
        "pub.dev",
        "*.pub.dev"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-access.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-package-install.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-done.sh"
          }
        ]
      }
    ]
  },
  "_note": "release tier. Force-push and hard reset stay denied. An earlier version of this note said the tier is 'only ever activated behind a human approval' — nothing enforced that: `make tier-release` copies this file into place and no check reads who ran it. The claim is removed rather than kept as decoration."
}
