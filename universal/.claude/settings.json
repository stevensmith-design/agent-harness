{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write",
      "Bash(make:*)", "Bash(./scripts/:*)",
      "Bash(git status)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git checkout -b:*)", "Bash(git switch:*)", "Bash(git fetch:*)",
      "Bash(git push:*)", "Bash(git pull --ff-only:*)", "Bash(git branch -d:*)", "Bash(git worktree:*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh pr merge:*)",
      "Bash(npm run:*)", "Bash(pnpm run:*)", "Bash(pnpm exec:*)", "Bash(yarn run:*)", "Bash(npx --no-install:*)",
      "Bash(flutter:*)", "Bash(dart:*)", "Bash(fvm:*)"
    ],
    "ask": [
      "Bash(npm install:*)", "Bash(npm i:*)", "Bash(npm add:*)", "Bash(npm update:*)",
      "Bash(pnpm install:*)", "Bash(pnpm add:*)", "Bash(pnpm update:*)",
      "Bash(yarn install:*)", "Bash(yarn add:*)", "Bash(yarn up:*)",
      "Bash(bun install:*)", "Bash(bun add:*)", "Bash(pip install:*)", "Bash(pip3 install:*)",
      "Bash(uv add:*)", "Bash(uv sync:*)", "Bash(poetry add:*)", "Bash(cargo add:*)", "Bash(go get:*)",
      "Bash(flutter pub add:*)", "Bash(flutter pub get:*)", "Bash(dart pub add:*)", "Bash(dart pub get:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)", "Bash(sudo:*)", "Bash(curl:* | sh)", "Bash(:(){:|:&};:)",
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.production)", "Read(./.env.development)", "Read(./.env.test)", "Read(./.env.staging)",
      "Read(./**/*credential*)", "Read(./**/*service-account*)",
      "Read(./**/*.pem)", "Read(./**/*.key)", "Read(./**/*.p12)", "Read(./**/*.pfx)",
      "Read(./.npmrc)", "Read(./.pypirc)", "Read(./.netrc)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git fetch *", "git pull *", "git push *", "gh *"],
    "filesystem": { "allowRead": ["."], "denyRead": ["./.env", "./.env.local", "./.env.production", "./.env.development", "./.env.test", "./.env.staging", "~/.ssh", "~/.aws"], "allowWrite": ["."] },
    "network": { "allowedDomains": ["registry.npmjs.org", "github.com", "*.github.com", "pub.dev", "*.pub.dev"] }
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" }] }],
    "PreToolUse":   [
      { "matcher": "Read|Grep|Glob|Bash", "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-access.sh" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-package-install.sh" }] },
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected.sh" }] }
    ],
    "PostToolUse":  [],
    "Stop":         []
  }
}
